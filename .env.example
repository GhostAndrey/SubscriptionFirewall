# Скопируйте в .env и заполните: cp .env.example .env
# docker compose подхватывает .env автоматически.

# Обязательно: API-ключи через запятую. Формат: ключ:скоупы (скоупы: ingest, read, manage, full).
SUBSCRIPTION_FIREWALL_API_KEYS=local-dev-key:full

# --- База данных ---
# По умолчанию firewall использует MySQL из docker-compose (сервис mysql).
# Чтобы использовать MySQL на хосте, раскомментируйте и подставьте пароль:
# SUBSCRIPTION_FIREWALL_DB_DSN=firewall:пароль@tcp(host.docker.internal:3306)/subscription_firewall?parseTime=true&loc=UTC

# Хранилище в памяти живёт только в одном процессе: одна реплика, данные
# теряются при рестарте. Для нескольких реплик нужен MySQL выше.
# SUBSCRIPTION_FIREWALL_STORAGE=auto

# --- Эмитент виртуальных карт ---
# simulated — заглушка для разработки, в продакшене использовать нельзя.
# SUBSCRIPTION_FIREWALL_ISSUER=simulated

# Пароли для MySQL из compose (для локальной разработки).
SUBSCRIPTION_FIREWALL_DB_PASSWORD=firewall
# SUBSCRIPTION_FIREWALL_DB_ROOT_PASSWORD=firewall-root

# --- Прочее (значения по умолчанию) ---
# SUBSCRIPTION_FIREWALL_ADDRESS=:8080
# SUBSCRIPTION_FIREWALL_LOG_LEVEL=info
# SUBSCRIPTION_FIREWALL_WORKERS=4
# SUBSCRIPTION_FIREWALL_QUEUE_CAPACITY=1024
# SUBSCRIPTION_FIREWALL_SWEEP_INTERVAL=1m
# SUBSCRIPTION_FIREWALL_ISSUER_MONTHLY_LIMIT=100000
# SUBSCRIPTION_FIREWALL_RATE_LIMIT=100
# SUBSCRIPTION_FIREWALL_RATE_BURST=200
# CIDR-список доверенных обратных прокси: для их запросов IP клиента берётся
# из X-Forwarded-For. Пусто — считать по адресу прямого соединения.
# SUBSCRIPTION_FIREWALL_TRUSTED_PROXIES=10.0.0.0/8
# Таймауты HTTP. IDLE_TIMEOUT ограничивает простой keep-alive соединения;
# пусто или 0 — использовать READ_TIMEOUT.
# SUBSCRIPTION_FIREWALL_READ_TIMEOUT=10s
# SUBSCRIPTION_FIREWALL_WRITE_TIMEOUT=10s
# SUBSCRIPTION_FIREWALL_IDLE_TIMEOUT=10s
# SUBSCRIPTION_FIREWALL_SHUTDOWN_TIMEOUT=10s
# Хранение истории. OUTBOX_RETENTION чистит завершённые задачи обоих outbox-ов;
# TRANSACTION_RETENTION и AUDIT_RETENTION чистят транзакции и audit_log
# (0 — не чистить; транзакции детекции нужны максимум за 2 года).
# SUBSCRIPTION_FIREWALL_OUTBOX_RETENTION=168h
# SUBSCRIPTION_FIREWALL_TRANSACTION_RETENTION=17520h
# SUBSCRIPTION_FIREWALL_AUDIT_RETENTION=8760h

# --- Rate limit на Redis (общий для всех реплик) ---
# По умолчанию compose использует redis:6379. Пусто — локальный in-memory limiter.
# SUBSCRIPTION_FIREWALL_REDIS_ADDR=redis:6379
# SUBSCRIPTION_FIREWALL_REDIS_PASSWORD=

# --- Трейсинг (OpenTelemetry, OTLP/HTTP) ---
# Раскомментируйте вместе с профилем tracing в compose (Jaeger UI на :16686):
# docker compose --profile tracing up -d
# SUBSCRIPTION_FIREWALL_OTLP_ENDPOINT=jaeger:4318
# По умолчанию трейсы экспортируются по TLS; для локального Jaeger включите plaintext:
# SUBSCRIPTION_FIREWALL_OTLP_INSECURE=true
